# syntax=docker/dockerfile:1

# Combined Docker image for C++ Arbitrage Bot + TS Redemption Service
# Optimized for low-latency trading on GCloud with LTO

# =============================================================================
# Stage 1: Build C++ arb bot
# =============================================================================
FROM debian:bookworm-slim AS cpp-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libcurl4-openssl-dev \
    libssl-dev \
    ca-certificates \
    autoconf \
    automake \
    libtool \
    pkg-config \
    zlib1g-dev \
    lld \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY cpp/ ./cpp/

WORKDIR /app/cpp

# Build with LTO enabled for 5-15% performance improvement
RUN mkdir -p build && cd build \
    && cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_LTO=ON \
    -DENABLE_NATIVE_ARCH=OFF \
    && make -j$(nproc) arb_test

# =============================================================================
# Stage 2: Build TS redemption service
# =============================================================================
FROM oven/bun:1.3.5 AS ts-builder

WORKDIR /app

# Copy package files first for better caching
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy source
COPY src/ ./src/
COPY tsconfig.json ./

# =============================================================================
# Stage 3: Minimal combined runtime
# =============================================================================
FROM debian:bookworm-slim AS runner

# Install runtime dependencies for both C++ and TS
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4 \
    libssl3 \
    ca-certificates \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Bun runtime copied from the pinned official image (no curl | bash, same version as CI)
COPY --from=ts-builder /usr/local/bin/bun /usr/local/bin/bun

# Create non-root user
RUN useradd --system --uid 1001 --create-home appuser

WORKDIR /app

# Copy C++ binary
COPY --from=cpp-builder /app/cpp/build/arb_test ./arb_test

# Copy TS app
COPY --from=ts-builder /app/node_modules ./ts/node_modules
COPY --from=ts-builder /app/src ./ts/src
COPY --from=ts-builder /app/package.json ./ts/package.json
COPY --from=ts-builder /app/tsconfig.json ./ts/tsconfig.json

# Copy entrypoint script (from build context root)
COPY --chmod=755 deploy/entrypoint.sh deploy/load-secrets.sh ./

# Set ownership
RUN chown -R appuser:appuser /app

USER appuser

# Environment variables (override at runtime)
# PRIVATE_KEY (or PRIVATE_KEY_SECRET, a Secret Manager version path) and FUNDER_ADDRESS must be
# provided at runtime. SAFE BY DEFAULT: the image runs in dry-run mode. Going live needs
# DRY_RUN=false AND CONFIRM_LIVE_TRADING=yes; see docs/maintenance.md before doing so.
ENV SIGNATURE_TYPE="2"
ENV SIZE_USDC="2"
ENV TRIGGER_COMBINED="0.995"
ENV MAX_COMBINED="1.00"
ENV DRY_RUN="true"
ENV DAEMON="true"
ENV POLL_INTERVAL_MS="30000"

# Health check - verify both processes are running
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pgrep -x arb_test > /dev/null && pgrep -x bun > /dev/null || exit 1

# Run combined entrypoint
CMD ["./entrypoint.sh"]
